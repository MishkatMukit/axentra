{
  "name": "axentra",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm -w apps/server run dev\" \"npm -w apps/client run dev\"",
    "build": "npm -w packages/contracts run build && npm -w apps/server run build && npm -w apps/client run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm -w apps/server run db:migrate",
    "db:generate": "npm -w apps/server run db:generate",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
