{
  "name": "axentra",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm -w apps/server run dev",
    "build": "npm -w packages/contracts run build && npm -w apps/server run build",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
