NODE_ENV=development
PORT=4000

# Hosted Postgres (Neon or Prisma Postgres). Use the standard postgresql:// string.
# Neon: use the direct (non-pooled) connection string so migrations work.
# Prisma Postgres: use the direct TCP string, not the prisma+postgres:// Accelerate URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
